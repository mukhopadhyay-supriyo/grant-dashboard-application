# Copy to .env (cp .env.example .env) and fill in. Never commit .env.
ENVIRONMENT=development

# API server
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed to call the API from a browser (Vite dev server)
CORS_ORIGINS=http://localhost:5173

# Where the chart data comes from. "mock" generates sample data;
# add your own source in src/services/ and register it in src/services/__init__.py
# Use DATA_SOURCE=mysql to read from the MySQL settings below.
DATA_SOURCE=mock
DATA_SOURCE_BASE_URL=
DATA_SOURCE_API_KEY=

# MySQL (see references/mysql_schema.sql for the expected tables)
MYSQL_HOST="grant-db.c3y486a8wivi.eu-north-1.rds.amazonaws.com"
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# AWS Credentials -->
ACCESS_KEY= 
SECRETE_ACCESS_KEY= 
REGION="eu-north-1"